# Django
# local: config.settings.develop
# Vercel test: config.settings.staging
# Hosting Ukraine (ADM Tools) prod: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.develop
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
ADMIN_URL=kvest-cms/

# Bootstrap staff on seed_demo / Vercel build (create if missing)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
# Set True once to reset password on next deploy, then turn off
ADMIN_PASSWORD_FORCE=False

# Database (empty = SQLite in develop; Postgres URL in staging/production)
# Vercel test: free Render Postgres (see .env.staging, gitignored)
# Hosting Ukraine Cloud PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=
POSTGRES_DB=quest
POSTGRES_USER=quest
POSTGRES_PASSWORD=change-me
DB_CONN_MAX_AGE=0

# Quest access price (LiqPay)
QUEST_PRICE=100
QUEST_CURRENCY=UAH

# LiqPay — fill later; leave empty for local/staging bypass
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SERVER_URL=https://example.com/api/v1/payment/webhook/liqpay/
LIQPAY_RESULT_URL=https://example.com/payment/return/
LIQPAY_SANDBOX=True
PAYMENTS_DEV_BYPASS=True

# Resend — fill later; develop/staging use console email backend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Vercel staging (copy from local .env.staging into Vercel env vars) ---
# DJANGO_SETTINGS_MODULE=config.settings.staging
# SECRET_KEY=...
# DEBUG=False
# DATABASE_URL=<Render external URL with ?sslmode=require>
# ALLOWED_HOSTS=.vercel.app
# CSRF_TRUSTED_ORIGINS=https://*.vercel.app
# PAYMENTS_DEV_BYPASS=True
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Hosting Ukraine / ADM Tools production (www.kvest-marafon.com) ---
# Copy to .env on the server (gitignored). See deploy/hosting-ukraine/README.md
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<strong-random>
# DEBUG=False
# ALLOWED_HOSTS=www.kvest-marafon.com,kvest-marafon.com
# CSRF_TRUSTED_ORIGINS=https://www.kvest-marafon.com,https://kvest-marafon.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# SECURE_SSL_REDIRECT=True
# HU_BIND_HOST=127.x.x.x
# HU_BIND_PORT=3000
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
# LIQPAY_PUBLIC_KEY=...
# LIQPAY_PRIVATE_KEY=...
# LIQPAY_SERVER_URL=https://www.kvest-marafon.com/api/v1/payment/webhook/liqpay/
# LIQPAY_RESULT_URL=https://www.kvest-marafon.com/payment/return/
# LIQPAY_SANDBOX=False
# PAYMENTS_DEV_BYPASS=False
# RESEND_API_KEY=...
# DEFAULT_FROM_EMAIL=noreply@kvest-marafon.com
# EMAIL_BACKEND=src.mailings.backends.ResendEmailBackend
# ADMIN_PASSWORD_FORCE=False
