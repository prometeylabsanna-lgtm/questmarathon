# Django
DJANGO_SETTINGS_MODULE=config.settings.develop
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database (empty = SQLite in develop; Postgres URL in production/Docker)
DATABASE_URL=
POSTGRES_DB=quest
POSTGRES_USER=quest
POSTGRES_PASSWORD=change-me

# Quest access price (LiqPay)
QUEST_PRICE=100
QUEST_CURRENCY=UAH

# LiqPay — fill later; leave empty for local develop bypass
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SERVER_URL=https://example.com/api/v1/payment/webhook/liqpay/
LIQPAY_RESULT_URL=https://example.com/payment/return/
LIQPAY_SANDBOX=True
PAYMENTS_DEV_BYPASS=True

# Resend — fill later; develop uses console email backend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
